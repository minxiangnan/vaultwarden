<main class="container-xxl">
    {{#if error}}
    <div class="align-items-center p-3 mb-3 text-opacity-50 text-dark bg-warning rounded shadow">
        <div>
            <h6 class="mb-0 text-dark">{{error}}</h6>
        </div>
    </div>
    {{/if}}

    <div class="vw-panel p-3 mb-3 rounded">
        <div>
            <h6 class="mb-1">需要管理口令</h6>
            <small>请输入 ADMIN_TOKEN。</small>

            <form class="form-inline" method="post" action="{{urlpath}}/admin">
                <input type="password" autocomplete="password" class="form-control w-50 mr-2" name="token" placeholder="管理口令" autofocus="autofocus">
                {{#if redirect}}
                <input type="hidden" id="redirect" name="redirect" value="/{{redirect}}">
                {{/if}}
                <button type="submit" class="btn btn-primary mt-2">进入</button>
            </form>
        </div>
    </div>
</main>
