# Copy to .env and fill in the blanks. .env is not committed.
#
#   cp .env.example .env
#
# ADMIN_TOKEN must be an Argon2 PHC string, not the password itself.
# Generate it with the server binary (it prompts, and nothing is echoed):
#
#   docker compose -f docker-compose.prod.yml run --rm --no-deps --entrypoint /vaultwarden vaultwarden hash
#
# Put the printed line below. Keep the single quotes so `$` is not expanded.
# ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$...'
ADMIN_TOKEN=

# Origin users type into the browser and the mobile app. No trailing slash.
DOMAIN=https://vault.example.com
# Hostname only. Caddy requests the certificate for this name.
DOMAIN_HOST=vault.example.com
# Optional. Caddy uses this address for Let's Encrypt expiry notices.
ACME_EMAIL=

# Closed registration. New people get an invitation from /admin.
SIGNUPS_ALLOWED=false
SIGNUPS_VERIFY=false
INVITATIONS_ALLOWED=true
INVITATION_ORG_NAME=Vaultwarden

# Required for the admin invitation email. Use starttls on 587 or force_tls on 465.
SMTP_HOST=
SMTP_FROM=
SMTP_FROM_NAME=Vaultwarden
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# MCP is how an AI client reads opted-in TOTP codes. Leave on for this release.
MCP_ENABLED=true
MCP_RATELIMIT_BURST=30
MCP_RATELIMIT_SECONDS=2

# info is the production level. debug can include request detail; do not use it on a public host.
LOG_LEVEL=info
EXTENDED_LOGGING=false

# Leave empty for SQLite in the data volume. Set only when using a database override.
# DATABASE_URL=
# POSTGRES_PASSWORD=
# MYSQL_PASSWORD=

# Image tag published by the release workflow.
VW_IMAGE_TAG=zh-authenticator
VW_VERSION=v-zh-authenticator-1.2.2
